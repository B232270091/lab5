{
  "info": {
    "name": "Lab05 — Хичээлд бүртгүүлэх API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get(\"runId\")) {",
          "  pm.collectionVariables.set(\"runId\", pm.variables.replaceIn(\"{{$randomUUID}}\"));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "T01 — Идэвхтэй оюутан урьдач нөхцөлөө хангаад бүртгүүлнэ",
      "item": [
        {
          "name": "Бэлтгэл — оюутны төлөв ба үзсэн хичээл",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"active\",\n  \"coursesTaken\": [\n    \"CS201\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/students/B231234567"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200 байна\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"result нь OK байна\", function () { pm.expect(pm.response.json().result).to.eql(\"OK\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Бэлтгэл — хичээлийн урьдач нөхцөл",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prerequisites\": [\n    \"CS201\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/courses/CS313"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200 байна\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"result нь OK байна\", function () { pm.expect(pm.response.json().result).to.eql(\"OK\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Идэвхтэй оюутан урьдач нөхцөлөө хангаад бүртгүүлнэ",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentID\": \"B231234567\",\n  \"courseID\": \"CS313\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/registrations"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 201 байна\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"result нь OK байна\", function () { pm.expect(pm.response.json().result).to.eql(\"OK\"); });",
                  "pm.test(\"registrationID нь эерэг тоо байна\", function () { pm.expect(pm.response.json().registrationID).to.be.a(\"number\").and.above(0); });"
                ]
              }
            }
          ]
        }
      ]
    },
